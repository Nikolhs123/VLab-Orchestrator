<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors repo/src/packages/com.vlab.orchestrator.core/Runtime/VLab.Orchestrator.Core.asmdef. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VLab.Orchestrator.Core</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0169;CS0067;CS0618</NoWarn>
    <DefineConstants>UNITY_2023_1_OR_NEWER;UNITY_6000_0_OR_NEWER;UNITY_STANDALONE_WIN</DefineConstants>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../repo/src</SourceRoot>
    <UnityEditorData Condition="'$(UnityEditorData)' == ''">C:/Program Files/Unity/Hub/Editor/6000.3.11f1/Editor/Data</UnityEditorData>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/packages/com.vlab.orchestrator.core/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="netstandard" HintPath="$(UnityEditorData)/NetStandard/ref/2.1.0/netstandard.dll" Private="false" />
    <Reference Include="$(UnityEditorData)/Managed/UnityEngine/*.dll" Private="false" />
  </ItemGroup>
</Project>
