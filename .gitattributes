* text=auto

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cff text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.prefab text eol=lf
*.txt text eol=lf

*.png binary

# Unity serializes empty YAML values with a trailing space.
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
